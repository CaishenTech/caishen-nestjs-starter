{
  "name": "caishen-nestjs-starter",
  "version": "0.1.0",
  "description": "A starting point for NestJS apps with Caishen SDK",
  "author": "Caishen Team",
  "private": false,
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.33.2",
    "@caishen/sdk": "^1.0.5",
    "@cardano-ogmios/client": "^6.11.2",
    "@cosmjs/amino": "^0.33.0",
    "@cosmjs/crypto": "^0.33.0",
    "@cosmjs/proto-signing": "^0.33.0",
    "@cosmjs/stargate": "^0.33.1",
    "@emurgo/cardano-serialization-lib-nodejs": "^14.1.1",
    "@fivebinaries/coin-selection": "^3.0.0",
    "@mysten/sui": "^1.29.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@ton/core": "^0.60.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.2.1",
    "axios": "^1.9.0",
    "bitcoinjs-lib": "^6.1.7",
    "bs58": "^6.0.0",
    "coinselect": "^3.1.13",
    "dotenv": "^16.5.0",
    "ecpair": "^3.0.0",
    "env-var": "^7.5.0",
    "husky": "9.1.7",
    "near-api-js": "^5.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^6.0.3",
    "uuid": "^11.1.0",
    "viem": "^2.29.0",
    "xrpl": "^4.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  }
}
